# Supabase browser configuration (public anon key only; never use service-role keys in Vite)
VITE_SUPABASE_URL=https://gcjvnpytgipqlgindews.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_-W1MQzldc5-b1A17DDQNgw_qOtKHeIP

# Application Configuration
VITE_APP_NAME=BizGuard
VITE_APP_VERSION=1.0.0
VITE_APP_URL=http://localhost:5173

# AI should be called through a server-side endpoint/Supabase Edge Function.
# Do NOT put OPENAI_API_KEY in Vite frontend env variables.
VITE_AI_ENDPOINT=

# Public payment keys only; secret keys belong on the server/Edge Functions.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Feature Flags
VITE_ENABLE_PHASE_1=true
VITE_ENABLE_PHASE_2=true
VITE_ENABLE_PHASE_3=true
VITE_ENABLE_PHASE_4=false
VITE_ENABLE_PHASE_5=false

# Vision fallback gateway. Leave enabled unless you intentionally want only Supabase Edge.
VITE_ENABLE_VISION_API_FALLBACK=true
# Optional same-origin override; default is /api/bizguard-vision
VITE_VISION_FALLBACK_URL=/api/bizguard-vision

# If using the Vercel fallback gateway, configure these as Vercel SERVER variables (never VITE_*):
# SUPABASE_URL=https://gcjvnpytgipqlgindews.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# OPENAI_API_KEY=your-server-only-openai-key
# OPENAI_VISION_MODEL=gpt-6-luna
